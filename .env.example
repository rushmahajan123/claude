# Copy this file to .env and fill in your values

# Required: Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here

# How often to search (minutes). Default: 60
SEARCH_INTERVAL_MINUTES=60

# SQLite database path. Default: jobs.db
DB_PATH=jobs.db

# Max web searches per agent run (controls cost). Default: 20
MAX_SEARCHES_PER_RUN=20
